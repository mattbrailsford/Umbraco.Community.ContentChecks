<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Umbraco Content Checks — Persistence (SQLite)</Title>
    <Description>SQLite migrations for Umbraco Content Checks persistence.</Description>
    <Company>Matt Brailsford</Company>
    <Authors>Matt Brailsford</Authors>
    <Copyright>Copyright © Matt Brailsford $([System.DateTime]::Today.ToString('yyyy'))</Copyright>
    <Product>Umbraco Content Checks</Product>
    <PackageProjectUrl>https://github.com/mattbrailsford/Umbraco.Community.ContentChecks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mattbrailsford/Umbraco.Community.ContentChecks</RepositoryUrl>
    <PackageTags>umbraco content-checks content quality validation umbraco-marketplace</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore.Sqlite" />
    <!-- Resolves NU1107 between EF Core Design's Roslyn dependency and the Umbraco.Code analyzer -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.ContentChecks.Persistence\Umbraco.Community.ContentChecks.Persistence.csproj" />
  </ItemGroup>

</Project>
