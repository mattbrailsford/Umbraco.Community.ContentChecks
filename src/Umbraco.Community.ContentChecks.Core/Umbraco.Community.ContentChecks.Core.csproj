<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Umbraco Content Checks</Title>
    <Description>Turn "what good content looks like" into an executable, triggerable check that returns a status plus actionable feedback — for editors, and for AI agents validating their own generated content.</Description>
    <Company>Matt Brailsford</Company>
    <Authors>Matt Brailsford</Authors>
    <Copyright>Copyright © Matt Brailsford $([System.DateTime]::Today.ToString('yyyy'))</Copyright>
    <Product>Umbraco Content Checks</Product>
    <PackageProjectUrl>https://github.com/mattbrailsford/Umbraco.Community.ContentChecks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mattbrailsford/Umbraco.Community.ContentChecks</RepositoryUrl>
    <PackageTags>umbraco content-checks content quality validation umbraco-marketplace</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="HtmlAgilityPack" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Umbraco.Community.ContentChecks.Persistence</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Umbraco.Test.ContentChecks.Unit</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Umbraco.Test.ContentChecks.Integration</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
