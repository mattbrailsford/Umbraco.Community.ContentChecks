<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Umbraco CMS — this line (v18/dev) tracks the v18 major only. v17 is maintained
         independently on v17/dev; see docs/overview.md §1 for the branch model. -->
    <PackageVersion Include="Umbraco.Cms" Version="[18.3.1,18.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[18.3.1,18.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.3.1,18.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[18.3.1,18.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[18.3.1,18.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Tests.Integration" Version="[18.3.1,18.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore" Version="[18.3.1,18.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore.SqlServer" Version="[18.3.1,18.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore.Sqlite" Version="[18.3.1,18.999.999)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <!-- Umbraco.AI — normal NuGet dependency of the .AI bridge project only, version range
         matching the same v18 line, per docs/ai-integration-spec.md. Never referenced from Core. -->
    <PackageVersion Include="Umbraco.AI.Core" Version="[18.8.0,18.999.999)" />
    <!-- Test -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="3.9.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.5.0" />
    <!-- Resolves NU1107 between Umbraco.Cms.Tests.Integration (Roslyn 5.9.0) and the Umbraco.Code analyzer (4.13.0) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <!-- Resolves the same NU1107 conflict for Microsoft.EntityFrameworkCore.Design (Roslyn 5.x) vs the Umbraco.Code analyzer -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>
</Project>
